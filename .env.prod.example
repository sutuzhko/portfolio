# Прод-секреты. Скопируй в `.env` рядом с docker-compose.prod.yml и заполни.
#   cp .env.prod.example .env  &&  nano .env
# Файл .env НЕ коммитим (он в .gitignore).

# --- База данных ---
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=ЗАМЕНИ_на_надёжный_пароль_БД
POSTGRES_DB=portfolio

# --- JWT (сгенерируй КАЖДЫЙ отдельно: openssl rand -hex 32) ---
JWT_ACCESS_SECRET=ЗАМЕНИ_openssl_rand_hex_32
JWT_REFRESH_SECRET=ЗАМЕНИ_другой_openssl_rand_hex_32
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Админ CRM (для входа в /admin; читается сидом) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ЗАМЕНИ_на_надёжный_пароль_админа

# --- Внешние профили для блока «Активность» ---
GITHUB_USERNAME=sutuzhko
CODEWARS_USERNAME=sutuzhko
