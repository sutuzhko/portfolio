DATABASE_URL="postgresql://postgres:postgres@localhost:5432/portfolio?schema=public"
PORT=3000

# Логины для прокси внешней статистики (/api/stats/*)
GITHUB_USERNAME=sutuzhko
CODEWARS_USERNAME=sutuzhko

# Секреты JWT — в проде задаются длинными случайными значениями из окружения.
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Учётка владельца приватной зоны (используется сидом).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Каталог для загруженных файлов (local-хранилище); в проде — путь к тому.
UPLOAD_DIR=./uploads
