# Токен проекта Chromatic для визуальных регрессий Storybook.
# Взять здесь: chromatic.com → проект → Manage → Configure → Project token.
# Локально: скопировать этот файл в .env и подставить значение, затем `pnpm chromatic`.
# В CI хранится в GitHub Secrets как CHROMATIC_PROJECT_TOKEN.
CHROMATIC_PROJECT_TOKEN=

# MSW-моки контракта. Ими правки в админке НЕ доходят до бэкенда (мок эхом
# возвращает патч и мутирует объект в памяти), поэтому для реальной записи
# должно быть false. Скрипты уже задают флаг: `pnpm dev` — false (реальный
# NestJS через прокси), `pnpm dev:mock` — true (фронт без бэкенда). Переменную
# трогают только чтобы переопределить это поведение вручную.
# VITE_ENABLE_MOCKS=false

# Куда Vite проксирует /api и /uploads в dev без моков. По умолчанию локальный
# бэкенд; менять, если NestJS поднят на другом хосте/порту.
# VITE_API_PROXY_TARGET=http://localhost:3000
