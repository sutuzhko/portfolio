{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    /* Типы для npm: JS и CSS собирает Vite, .d.ts — tsc. */
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationDir": "./dist",
    "rootDir": "./src",
    "types": ["vite/client", "node"]
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/**/*.stories.tsx", "src/test/**"]
}
